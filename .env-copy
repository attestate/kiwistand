OPTIMISM_RPC_HTTP_HOST=https://opt-mainnet.g.alchemy.com/v2/
# Optional: comma-separated OP RPCs for the delegation crawler. The first one
# is polled for new blocks, eth_getLogs rotates through all of them.
OPTIMISM_CRAWLER_RPC_HOSTS=
RPC_HTTP_HOST=https://eth-mainnet.g.alchemy.com/v2/
DEBUG="attestate*"
NODE_ENV=test
BIND_ADDRESS_V4=0.0.0.0
PORT=53462
IS_BOOTSTRAP_NODE=false
USE_EPHEMERAL_ID=false
BLOCKED_AT=false
IPV4=127.0.0.1
HTTP_MESSAGES_MAX_PAGE_SIZE=500
DATA_DIR=anon
CACHE_DIR=cache
AUTO_SYNC=true
ROOT_ADVERTISEMENT_TIMEOUT=60000
MIN_TIMESTAMP_SECS=1672527600
MAX_TIMESTAMP_DELTA_SECS=60
# frontend vars
HTTP_PORT=0
API_PORT=0
TOTAL_STORIES=20
TOTAL_USERS=20
ENSDATA_KEY=ensdata
CF_IMAGES_SECRET=secret
USER_AGENT="KiwiNewsBot/1.0 (https://news.kiwistand.com)"
CF_API_TOKEN=your-cloudflare-api-token
CF_ZONE_ID=your-cf-zone
# Social posting (src/social-posting.mjs). A channel is enabled when all of
# its vars are set; check with `node scripts/social-test.mjs --dry-run`.
# X: app keys from developer.x.com, access token via scripts/twitter-auth.mjs
CONSUMER_KEY=
CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Farcaster via Neynar: API key and an approved signer (scripts/create-farcaster-signer.mjs)
NEYNAR_API_KEY=
FC_SIGNER_UUID=
# Farcaster via a hub, no paid API: our own key (scripts/create-farcaster-key.mjs)
# and a hub's HTTP API. Used when Neynar fails or isn't set.
FC_FID=
FC_SIGNER_PRIVATE_KEY=
FC_HUB_URL=
# Telegram: bot token and channel id (no default: the old channel is the NFT
# holders' chat). Posts only on these UTC weekdays, 0 is Sunday.
TG_KEY=
TG_CHANNEL_ID=
TELEGRAM_POST_WEEKDAYS=0
# Daily automatic post of the top story: on in production unless "false"
SOCIAL_AUTOPOST=
SOCIAL_POST_HOURS_UTC=16
SOCIAL_MIN_UPVOTES=2
# Daily push of the same top story, as a Farcaster mini app notification
# (needs NEYNAR_API_KEY above) and a OneSignal broadcast to the iOS app (needs
# ONESIGNAL_API_KEY). Only sends when NODE_ENV is production. On whenever the
# daily post is on, unless "false". Never pushes a story twice, also not one
# pushed by hand via POST /api/v1/neynar/notify.
ONESIGNAL_API_KEY=
DAILY_PUSH=
