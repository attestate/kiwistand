// Serves the static docs build at news.kiwistand.com/docs. There is no Worker
// script: Cloudflare serves the files in dist/public directly. Every other
// path on news.kiwistand.com keeps going to the node. See README.md.
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kiwistand-docs",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist/public",
    // The build's HTML links to /docs/..., while the files sit at the root of
    // dist/public. base_path maps /docs/foo to dist/public/foo.
    "base_path": "/docs",
    // Serves /docs/ from index.html and /docs/protocol from protocol.html
    // (scripts/postbuild.mjs writes pages that way), and redirects /docs to
    // /docs/ and /docs/protocol/ to /docs/protocol.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [{ "pattern": "news.kiwistand.com/docs*", "zone_name": "kiwistand.com" }],
  // Only serve the docs on the route above, not on a *.workers.dev URL too.
  "workers_dev": false
}
